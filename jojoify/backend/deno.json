{
  "tasks": {
    "dev": "deno run --env-file --allow-net --allow-env --watch src/main.ts",
    "start": "deno run --env-file --allow-net --allow-env src/main.ts",
    "check": "deno check src/main.ts",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "imports": {
    "@google/genai": "npm:@google/genai@^2.2.0"
  }
}
